OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LOG_LEVEL=INFO
DATA_DIR=./data
PROJECTS_DIR=./data/projects
CACHE_DIR=./data/cache
KNOWLEDGE_DIR=./data/knowledge

# LLM provider: openai | ollama
# "openai" (default) uses LLMService against the OpenAI API and requires
# OPENAI_API_KEY. "ollama" uses OllamaLLMService against a local Ollama
# server's HTTP API and requires no API key, only a running Ollama install.
# Switching providers only requires changing this one value.
LLM_PROVIDER=openai

# Ollama configuration (only used when LLM_PROVIDER=ollama)
# Install Ollama, run `ollama pull qwen2.5:3b` (or llama3.2:3b), then set
# LLM_PROVIDER=ollama above. No API key needed.
# OLLAMA_TIMEOUT is a *read* timeout (connect timeout is a fixed, short 10s
# internally). 600s (10 min) gives CPU-only inference room for a cold model
# load; Atlas also sets Ollama's keep_alive so the model stays warm between
# calls within a pipeline run, so only the first call should ever be slow.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=600

# Search provider: auto | tavily | serpapi | wikipedia | duckduckgo
# "auto" uses Tavily if TAVILY_API_KEY is set, else SerpAPI if SERPAPI_API_KEY
# is set, else Wikipedia's official search JSON API (stable, no key needed).
# "duckduckgo" scrapes DuckDuckGo's HTML results (no key, but fragile) and
# automatically falls back to Wikipedia if it can't be parsed.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=
